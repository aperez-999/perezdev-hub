{
  "name": "perezdev-hub",
  "version": "0.3.0",
  "description": "Write your AI agent setup once — skills, rules, and MCP servers — for Claude Code, Codex, Cursor, Copilot, Cline, Windsurf, and Roo, and catch drift in CI.",
  "type": "module",
  "bin": {
    "perezdev": "dist/index.js",
    "pdh": "dist/index.js",
    "perezdev-hub": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "agent-skills",
    "skill-md",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "cline",
    "windsurf",
    "roo-code",
    "agents-md",
    "cli",
    "developer-tools",
    "lockfile"
  ],
  "author": "Alejandro Perez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aperez-999/perezdev-hub.git"
  },
  "homepage": "https://github.com/aperez-999/perezdev-hub#readme",
  "bugs": {
    "url": "https://github.com/aperez-999/perezdev-hub/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.135.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

{
  "name": "perezdev-hub",
  "version": "0.1.0",
  "description": "PerezDev Hub — your AI dev workflow hub: generate custom agents, install curated stacks, and manage skills/MCP servers across Claude Code, Cursor, Copilot, Codex.",
  "type": "module",
  "bin": {
    "perezdev": "./dist/index.js",
    "pdh": "./dist/index.js",
    "inspo": "./dist/index.js"
  },
  "files": [
    "dist",
    "python"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "claude",
    "cursor",
    "copilot",
    "codex",
    "mcp",
    "skills",
    "tui",
    "developer-tools"
  ],
  "author": "Alejandro Perez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/USERNAME/perezdev-hub.git"
  },
  "homepage": "https://github.com/USERNAME/perezdev-hub#readme",
  "bugs": {
    "url": "https://github.com/USERNAME/perezdev-hub/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "gray-matter": "^4.0.3",
    "ink": "^5.1.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.69.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
